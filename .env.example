APP_ENV=dev
LOG_LEVEL=INFO
USE_STUBS=true

DATABASE_URL=postgresql+asyncpg://rivet:rivet@localhost:5432/rivet
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# not MILVUS_URI: pymilvus reads that name itself via its own load_dotenv() and chokes on a
# local file path (it expects a server address) -- see CLAUDE.md's known gotchas
RIVET_MILVUS_URI=./data/milvus.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rivet-dev-password

# set ANTHROPIC_API_KEY to turn on the real parser/router (LangChain, Anthropic-only) and,
# when LLM_PROVIDER=anthropic, the real answerer (DeepAgents); empty = stub
# LLM_PROVIDER picks the answerer's model backend: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

JWT_SECRET=change-me
JWT_TTL_MINUTES=60
RESPONSE_CACHE_TTL_SECONDS=300
