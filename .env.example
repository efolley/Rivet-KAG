APP_ENV=dev
LOG_LEVEL=INFO
USE_STUBS=true

DATABASE_URL=postgresql+asyncpg://rivet:rivet@localhost:5432/rivet
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MILVUS_URI=./data/milvus.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rivet-dev-password

# set ANTHROPIC_API_KEY to turn on the real request parser/router (LangChain); empty = stub
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

JWT_SECRET=change-me
